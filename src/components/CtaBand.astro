---
import { SITE } from '../data/site.js';
import Form from './Form.astro';
import Icon from './Icon.astro';
import * as I from '../data/icons.js';
const { title = 'Ready to build an organisation where people genuinely thrive?' } = Astro.props;
---
<section class="cta sec" id="enquire"><div class="wrap">
  <div class="rv l"><span class="eyebrow">Let's talk</span><h2>{title}</h2>
    <p>Performance follows when people are aligned. Tell us what you are facing and we will design a solution around it, from scratch.</p>
    <ul class="cinfo"><li><a href={`tel:${SITE.tel}`}><Icon d={I.phone} /><span>{SITE.phone}</span></a></li><li><a href={`mailto:${SITE.email}`}><Icon d={I.mail} /><span>{SITE.email}</span></a></li><li><span><Icon d={I.pin} />Durban, KwaZulu-Natal</span></li><li><span><Icon d={I.clock} />{SITE.hours}</span></li></ul></div>
  <div class="rv r"><Form id="f-cta" /></div>
</div></section>
