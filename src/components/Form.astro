---
import { SERVICES } from '../data/site.js';
import Arrow from './Arrow.astro';
const { id, title = 'Book a free consultation', sub = 'Tell us about your challenge. We reply within one working day.', src = 'contact' } = Astro.props;
---
<form class="form" id={id} data-form={src} method="post" action="/contact.php">
  <h3>{title}</h3><p class="sub">{sub}</p>
  <input type="hidden" name="source" value={src} />
  <div class="f hp" aria-hidden="true"><label>Leave blank<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
  <div class="row"><div class="f"><label for={`${id}-n`}>Full name *</label><input id={`${id}-n`} name="name" required autocomplete="name" /></div>
    <div class="f"><label for={`${id}-c`}>Company</label><input id={`${id}-c`} name="company" autocomplete="organization" /></div></div>
  <div class="row"><div class="f"><label for={`${id}-e`}>Email *</label><input id={`${id}-e`} type="email" name="email" required autocomplete="email" /></div>
    <div class="f"><label for={`${id}-p`}>Phone *</label><input id={`${id}-p`} type="tel" name="phone" required autocomplete="tel" /></div></div>
  <div class="f"><label for={`${id}-s`}>I'm interested in</label><select id={`${id}-s`} name="service"><option value="">Select a service</option>{SERVICES.map((s) => <option>{s.title}</option>)}<option>Not sure yet</option></select></div>
  <div class="f"><label for={`${id}-m`}>How can we help?</label><textarea id={`${id}-m`} name="message" rows="3"></textarea></div>
  <button class="btn btn-p" type="submit"><span>Send enquiry</span><Arrow /></button>
  <div class="msg" role="alert"></div>
  <p class="note">We only use your details to respond to your enquiry. See our <a href="/privacy-policy/">Privacy Policy</a>.</p>
</form>
