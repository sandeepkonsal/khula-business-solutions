---
// Original on-brand illustration per service. Replaced automatically if public/images/services/<slug>.jpg exists.
import fs from 'node:fs';
const { slug, title } = Astro.props;
const photo = fs.existsSync(`public/images/services/${slug}.jpg`) ? `/images/services/${slug}.jpg` : null;
const labels = {
  'pre-post-intervention-diagnostic': 'Bar chart showing performance before and after an intervention, with a magnifying glass',
  'nlp-executive-coaching': 'Two speech bubbles representing a coaching conversation, with a spark of insight',
  'tailored-training-solutions': 'A presentation screen in front of a group of learners',
  'mindset-behaviour-transformation': 'Two interlocking gears with an upward arrow, representing mindset driving behaviour',
  'change-management': 'A person climbing steps toward a flag, representing guided change',
  'project-management': 'A project timeline chart with milestones and a finish flag',
  'business-computer-skills-training': 'A laptop showing a spreadsheet and chart with a cursor',
  'train-the-trainer': 'A trainer passing skills on to a row of new trainers',
  'digital-marketing': 'A browser window with a rising growth chart next to a phone with notifications',
};
---
<figure class="art-frame">
  {photo ? <img src={photo} alt={labels[slug] ?? title} width="1600" height="1200" /> : (
  <svg viewBox="0 0 480 360" role="img" aria-label={labels[slug] ?? title} xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="ag" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ffb870"/><stop offset="1" stop-color="#e07830"/></linearGradient>
      <linearGradient id="av" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffb870"/><stop offset="1" stop-color="#b85c20"/></linearGradient>
      <radialGradient id="glow"><stop offset="0" stop-color="#e07830" stop-opacity=".45"/><stop offset="1" stop-color="#e07830" stop-opacity="0"/></radialGradient>
      <linearGradient id="area" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#e07830" stop-opacity=".5"/><stop offset="1" stop-color="#e07830" stop-opacity="0"/></linearGradient>
      <pattern id="dots" width="22" height="22" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1.2" fill="#fff" opacity=".07"/></pattern>
    </defs>
    <rect width="480" height="360" fill="#101010"/><rect width="480" height="360" fill="url(#dots)"/>
    <circle cx="370" cy="70" r="190" fill="url(#glow)"/>
    <polygon points="0,360 0,250 110,360" fill="#e07830" opacity=".12"/><polygon points="480,360 480,230 340,360" fill="#b85c20" opacity=".18"/>

    {slug === 'pre-post-intervention-diagnostic' && <g>
      <rect x="55" y="55" width="370" height="250" rx="18" fill="#1a1a1a" stroke="#ffffff" stroke-opacity=".1"/>
      <g fill="#6e645a"><rect x="95" y="210" width="26" height="40" rx="4"/><rect x="130" y="195" width="26" height="55" rx="4"/><rect x="165" y="205" width="26" height="45" rx="4"/></g>
      <path d="M205 160h40m-10-10l10 10-10 10" stroke="#ffb870" stroke-width="4" fill="none" stroke-linecap="round" stroke-linejoin="round" class="pulse"/>
      <g fill="url(#av)"><rect x="265" y="170" width="26" height="80" rx="4"/><rect x="300" y="145" width="26" height="105" rx="4"/><rect x="335" y="120" width="26" height="130" rx="4"/><rect x="370" y="92" width="26" height="158" rx="4"/></g>
      <line x1="80" y1="250" x2="405" y2="250" stroke="#fff" stroke-opacity=".2"/>
      <g font-family="Inter,sans-serif" font-size="11" letter-spacing="2" fill="#b9ada1"><text x="95" y="274">BEFORE</text><text x="300" y="274">AFTER</text></g>
      <g class="fl" stroke="#ffb870" stroke-width="5" fill="none" stroke-linecap="round"><circle cx="150" cy="105" r="24" fill="#101010"/><path d="M168 123l22 22"/></g>
    </g>}

    {slug === 'nlp-executive-coaching' && <g>
      <g class="fl"><rect x="60" y="70" width="210" height="100" rx="24" fill="#1a1a1a" stroke="#ffb870" stroke-width="2"/><polygon points="100,170 100,198 130,170" fill="#1a1a1a" stroke="#ffb870" stroke-width="2"/><rect x="100" y="168" width="34" height="5" fill="#1a1a1a"/>
        <g fill="#ffb870" opacity=".85"><rect x="90" y="98" width="140" height="9" rx="4.5"/><rect x="90" y="120" width="110" height="9" rx="4.5" opacity=".6"/><rect x="90" y="142" width="125" height="9" rx="4.5" opacity=".4"/></g></g>
      <g class="fl2"><rect x="210" y="190" width="215" height="100" rx="24" fill="url(#ag)"/><polygon points="380,290 380,318 350,290" fill="#e07830"/>
        <g fill="#2a1608" opacity=".85"><rect x="240" y="218" width="150" height="9" rx="4.5"/><rect x="240" y="240" width="115" height="9" rx="4.5" opacity=".6"/><rect x="240" y="262" width="135" height="9" rx="4.5" opacity=".4"/></g></g>
      <path d="M385 70l8 22 22 8-22 8-8 22-8-22-22-8 22-8z" fill="#ffb870" class="pulse"/><circle cx="330" cy="110" r="4" fill="#ffb870"/><circle cx="420" cy="150" r="3" fill="#e07830"/>
    </g>}

    {slug === 'tailored-training-solutions' && <g>
      <rect x="80" y="50" width="320" height="175" rx="14" fill="#1a1a1a" stroke="#fff" stroke-opacity=".12"/><rect x="80" y="50" width="320" height="26" rx="14" fill="#242424"/>
      <circle cx="100" cy="63" r="4" fill="#ffb870"/><circle cx="114" cy="63" r="4" fill="#e07830"/><circle cx="128" cy="63" r="4" fill="#b85c20"/>
      <rect x="105" y="98" width="120" height="12" rx="6" fill="#ffb870"/><g fill="#6e645a"><rect x="105" y="122" width="150" height="8" rx="4"/><rect x="105" y="140" width="130" height="8" rx="4"/><rect x="105" y="158" width="100" height="8" rx="4"/></g>
      <polyline points="270,200 300,170 325,185 360,120" fill="none" stroke="url(#ag)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M270 206h110" stroke="#fff" stroke-opacity=".2"/>
      <g class="fl"><path d="M365 105l10 10-10 10-10-10z" fill="#ffb870"/></g>
      <g>{[110, 170, 240, 310, 370].map((x, i) => <g><circle cx={x} cy="268" r="15" fill={i === 2 ? 'url(#ag)' : '#3a3a3a'}/><path d={`M${x - 24} 322c0-16 11-28 24-28s24 12 24 28z`} fill={i === 2 ? 'url(#av)' : '#2c2c2c'}/></g>)}</g>
    </g>}

    {slug === 'mindset-behaviour-transformation' && <g>
      <g class="spin" style="transform-origin:200px 170px"><circle cx="200" cy="170" r="78" fill="none" stroke="url(#ag)" stroke-width="22" stroke-dasharray="14 11"/><circle cx="200" cy="170" r="62" fill="#161616" stroke="#ffb870" stroke-opacity=".5" stroke-width="2"/></g>
      <g class="spin r" style="transform-origin:330px 235px"><circle cx="330" cy="235" r="48" fill="none" stroke="#e07830" stroke-width="16" stroke-dasharray="11 9"/><circle cx="330" cy="235" r="36" fill="#161616" stroke="#e07830" stroke-opacity=".5" stroke-width="2"/></g>
      <path d="M200 205v-70m-22 24l22-26 22 26" stroke="#ffb870" stroke-width="7" fill="none" stroke-linecap="round" stroke-linejoin="round" class="pulse"/>
      <g font-family="Inter,sans-serif" font-size="11" letter-spacing="2" fill="#b9ada1"><text x="158" y="285">MINDSET</text><text x="292" y="305">BEHAVIOUR</text></g>
    </g>}

    {slug === 'change-management' && <g>
      <g fill="#262626" stroke="#ffb870" stroke-width="2"><rect x="50" y="270" width="100" height="26" rx="6"/><rect x="150" y="230" width="100" height="66" rx="6"/><rect x="250" y="190" width="100" height="106" rx="6"/><rect x="350" y="150" width="90" height="146" rx="6"/></g>
      <path d="M70 230c60-90 200-120 300-120" fill="none" stroke="#ffb870" stroke-width="3" stroke-dasharray="3 9" stroke-linecap="round" opacity=".7"/>
      <g class="fl"><circle cx="300" cy="160" r="13" fill="url(#ag)"/><path d="M280 190c0-12 9-20 20-20s20 8 20 20z" fill="url(#av)"/></g>
      <g><line x1="395" y1="150" x2="395" y2="88" stroke="#ffb870" stroke-width="4" stroke-linecap="round"/><path d="M395 90l42 13-42 15z" fill="url(#ag)" class="pulse"/></g>
      <circle cx="100" cy="250" r="9" fill="#6e645a"/><circle cx="200" cy="210" r="9" fill="#9a8a7c"/>
    </g>}

    {slug === 'project-management' && <g>
      <rect x="45" y="50" width="390" height="260" rx="18" fill="#1a1a1a" stroke="#fff" stroke-opacity=".1"/>
      <g fill="#fff" opacity=".1"><rect x="70" y="84" width="60" height="9" rx="4.5"/><rect x="70" y="124" width="60" height="9" rx="4.5"/><rect x="70" y="164" width="60" height="9" rx="4.5"/><rect x="70" y="204" width="60" height="9" rx="4.5"/><rect x="70" y="244" width="60" height="9" rx="4.5"/></g>
      <g fill="url(#ag)"><rect x="150" y="80" width="110" height="16" rx="8"/><rect x="190" y="120" width="130" height="16" rx="8"/><rect x="235" y="160" width="100" height="16" rx="8" opacity=".8"/></g>
      <g fill="#6e645a"><rect x="290" y="200" width="90" height="16" rx="8"/><rect x="330" y="240" width="70" height="16" rx="8"/></g>
      <line x1="285" y1="68" x2="285" y2="292" stroke="#ffb870" stroke-width="2" stroke-dasharray="5 6"/>
      <path d="M262 110l10 10-10 10-10-10z" fill="#ffb870" class="pulse"/>
      <g class="fl"><line x1="404" y1="262" x2="404" y2="218" stroke="#ffb870" stroke-width="4" stroke-linecap="round"/><path d="M404 220l28 9-28 11z" fill="#e07830"/></g>
      <circle cx="130" cy="88" r="9" fill="#ffb870"/><path d="M126 88l3 3 5-6" stroke="#101010" stroke-width="2" fill="none" stroke-linecap="round"/>
    </g>}

    {slug === 'business-computer-skills-training' && <g>
      <rect x="105" y="60" width="270" height="180" rx="14" fill="#1a1a1a" stroke="#ffb870" stroke-width="2"/>
      <rect x="105" y="60" width="270" height="24" rx="14" fill="#242424"/><circle cx="123" cy="72" r="3.5" fill="#ffb870"/><circle cx="136" cy="72" r="3.5" fill="#e07830"/><circle cx="149" cy="72" r="3.5" fill="#b85c20"/>
      <g stroke="#fff" stroke-opacity=".14"><path d="M125 112h130M125 134h130M125 156h130M125 178h130M125 200h130"/><path d="M165 100v110M205 100v110M245 100v110"/></g>
      <g fill="url(#av)"><rect x="275" y="170" width="18" height="34" rx="3"/><rect x="299" y="150" width="18" height="54" rx="3"/><rect x="323" y="125" width="18" height="79" rx="3"/></g>
      <path d="M70 242h340l-26 30H96z" fill="#262626" stroke="#ffffff" stroke-opacity=".15"/><rect x="215" y="245" width="50" height="6" rx="3" fill="#101010"/>
      <g class="fl"><path d="M300 190l0 36 9-9 8 17 7-3-8-17 12-2z" fill="#ffb870" stroke="#101010" stroke-width="2" stroke-linejoin="round"/></g>
      <g class="fl2"><rect x="400" y="95" width="46" height="34" rx="8" fill="#1a1a1a" stroke="#e07830"/><rect x="410" y="105" width="26" height="5" rx="2.5" fill="#ffb870"/><rect x="410" y="115" width="16" height="5" rx="2.5" fill="#6e645a"/></g>
    </g>}

    {slug === 'train-the-trainer' && <g>
      <g class="fl"><circle cx="240" cy="95" r="28" fill="url(#ag)"/><path d="M196 190c0-30 20-50 44-50s44 20 44 50z" fill="url(#av)"/></g>
      <g stroke="#ffb870" stroke-width="2" stroke-dasharray="4 7" opacity=".8" fill="none"><path d="M240 195C230 225 160 225 125 262"/><path d="M240 195V262"/><path d="M240 195C250 225 320 225 355 262"/></g>
      <g>{[125, 240, 355].map((x, i) => <g><circle cx={x} cy="285" r="17" fill={i === 1 ? '#e07830' : '#4a4a4a'}/><path d={`M${x - 28} 340c0-18 12-31 28-31s28 13 28 31z`} fill={i === 1 ? '#b85c20' : '#303030'}/></g>)}</g>
      <g fill="#ffb870" class="pulse"><path d="M125 236l4 9 9 4-9 4-4 9-4-9-9-4 9-4z"/><path d="M355 236l4 9 9 4-9 4-4 9-4-9-9-4 9-4z"/></g>
      <g font-family="Inter,sans-serif" font-size="11" letter-spacing="2" fill="#b9ada1"><text x="304" y="106">TRAINER</text></g>
    </g>}

    {slug === 'digital-marketing' && <g>
      <rect x="45" y="50" width="300" height="215" rx="16" fill="#1a1a1a" stroke="#fff" stroke-opacity=".12"/>
      <rect x="45" y="50" width="300" height="28" rx="16" fill="#242424"/><circle cx="63" cy="64" r="4" fill="#ffb870"/><circle cx="77" cy="64" r="4" fill="#e07830"/><circle cx="91" cy="64" r="4" fill="#b85c20"/>
      <rect x="110" y="56" width="180" height="16" rx="8" fill="#101010"/><circle cx="123" cy="64" r="4" fill="none" stroke="#ffb870" stroke-width="1.5"/>
      <path d="M70 230 L120 205 L165 215 L215 170 L265 150 L320 105 V240 H70z" fill="url(#area)"/>
      <polyline points="70,230 120,205 165,215 215,170 265,150 320,105" fill="none" stroke="url(#ag)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="320" cy="105" r="8" fill="#ffb870" class="pulse"/>
      <g stroke="#fff" stroke-opacity=".1"><path d="M70 130h250M70 170h250M70 210h250"/></g>
      <g class="fl"><rect x="320" y="120" width="105" height="200" rx="20" fill="#1a1a1a" stroke="#ffb870" stroke-width="2"/><rect x="360" y="130" width="25" height="5" rx="2.5" fill="#101010"/>
        <rect x="334" y="152" width="77" height="38" rx="10" fill="url(#ag)"/><rect x="334" y="200" width="77" height="30" rx="10" fill="#2a2a2a"/><rect x="334" y="240" width="77" height="30" rx="10" fill="#2a2a2a"/></g>
      <g class="fl2"><path d="M70 300v-26a3 3 0 0 1 3-3h10l30-22v76l-30-22H73a3 3 0 0 1-3-3z" fill="#ffb870"/><path d="M136 262a22 22 0 0 1 0 32" stroke="#e07830" stroke-width="5" fill="none" stroke-linecap="round"/></g>
    </g>}
  </svg>)}
</figure>
