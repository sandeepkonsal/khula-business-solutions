---
import Base from '../layouts/Base.astro';
import Form from '../components/Form.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import * as I from '../data/icons.js';
import { SITE, SERVICES, TESTIMONIALS, CLIENTS } from '../data/site.js';
import { org, faq } from '../data/schema.js';
const qa = [['How much does corporate training in Durban cost?', 'Every programme is designed from scratch, so pricing depends on scope, group size and outcomes. Book a short call and we will give you a clear proposal.'], ['Do you deliver on-site?', 'Yes. We deliver at your premises or a venue of your choice in Durban and across South Africa.'], ['How soon can we start?', 'After an initial conversation we will scope and agree a plan. Contact us for current availability.']];
---
<Base title="Corporate Training Durban | Tailored & Measured | Khula" desc="Tailored corporate training and NLP coaching in Durban. Built from scratch, measured with pre/post diagnostics. Trusted by Transnet, Unilever & government. Book a call." path="/corporate-training-durban/" noindex bare ld={[faq(qa), org]}>
  <header class="lp-nav"><div class="wrap"><a href="/" aria-label="Khula home"><img src="/assets/logo.png" alt={SITE.name} width="135" height="52" style="height:52px;width:auto" /></a><a class="tel" href={`tel:${SITE.tel}`}><Icon d={I.phone} class="" /> {SITE.phone}</a></div></header>
  <section class="hero lp-hero" style="min-height:0"><canvas id="fx" aria-hidden="true"></canvas><div class="wrap"><div>
    <span class="eyebrow">Durban corporate training &amp; coaching</span><h1>Corporate training in Durban that <span class="grad-text">changes behaviour,</span> not just attendance.</h1>
    <p class="lead" style="font-size:1.2rem;color:#d8cbbf">Tailored programmes built from scratch around your culture and numbers, with pre- and post-intervention diagnostics that prove the impact.</p>
    <ul class="ticks"><li>29+ years of people-transformation experience</li><li>Built from scratch. No recycled courseware</li><li>Measured results with pre- and post-diagnostics</li><li>Trusted by Transnet, Unilever, RCL Foods &amp; government departments</li></ul>
    <div class="ctas" style="display:flex;gap:14px;flex-wrap:wrap"><a class="btn btn-p" href={`tel:${SITE.tel}`}>Call {SITE.phone}</a><a class="btn btn-g" href={SITE.wa} target="_blank" rel="noopener">WhatsApp us</a></div></div>
    <div class="rv in"><Form id="f-lp" title="Get a free consultation" sub="Tell us your challenge. We’ll reply within one working day." src="ppc-landing" /></div></div></section>
  <div class="marq"><div class="marq-label">Trusted by</div><div class="track">{[...CLIENTS, ...CLIENTS].map((c) => <span>{c}</span>)}</div></div>
  <section class="sec cream"><div class="wrap"><div class="sec-head rv center" style="text-align:center"><span class="eyebrow">What we solve</span><h2>Eight ways we lift performance through people</h2></div><div class="related">{SERVICES.filter((s) => s.group === 'people').map((s, i) => <a class="rv" style={`--d:${i % 3}`} href={`/services/${s.slug}/`}><b>{s.title}</b><span>{s.short}</span></a>)}</div></div></section>
  <section class="sec"><div class="wrap"><div class="tcar rv"><div style="overflow:hidden"><div class="ttrack">{TESTIMONIALS.map((t) => <div class="tcard"><figure><blockquote>“{t[0]}”</blockquote><figcaption><span class="av">{t[1][0]}</span><div><b>{t[1]}</b><span>{t[2]}</span></div></figcaption></figure></div>)}</div></div><div class="tdots"></div></div></div></section>
  <section class="sec cream"><div class="wrap"><div class="sec-head rv center" style="text-align:center"><h2>Quick answers</h2></div><Faq items={qa} /></div></section>
  <footer class="ftr"><div class="wrap"><div class="fbar" style="border:0;margin:0;padding:0"><span>© {new Date().getFullYear()} {SITE.name} · Durban</span><span><a href="/">Visit full website</a></span></div></div></footer>
</Base>
