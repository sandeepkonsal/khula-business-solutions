---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE, SERVICES, TESTIMONIALS, CLIENTS, HOME_FAQ } from '../data/site.js';
import { org, faq } from '../data/schema.js';

const slides = [
  { eb: 'People-transformation, not training', h: 'Learning to live,|Living to learn.', caps: true, first: true, lead: 'Khula Business Solutions has spent almost three decades helping leaders and organisations close the gap between the performance they’re delivering and the performance they’re actually capable of, built from scratch, every time.', cta: 'Let’s Talk', core: ['29+', 'Years of experience'], chips: ['Built from scratch', 'Behaviour-led', 'Measured impact'] },
  { eb: 'Durban · 29+ years of people-transformation', h: 'People-transformation, not training.', lead: 'We solve business performance problems through learning. Every intervention is built from scratch around your culture, your challenges and your numbers.', core: ['9', 'Specialist services'], chips: ['Built from scratch', 'Behaviour-led', 'Measured impact'] },
  { eb: 'The human operating system', h: 'The bottleneck is rarely the system. It’s the people behind it.', lead: 'When organisations think they have a performance problem, they usually have a behaviour problem. We close the gap between the performance you deliver and the performance you are capable of.', core: ['100%', 'Female-owned & managed'], chips: ['NLP-certified', 'Evidence-based', 'Relentlessly tailored'] },
  { eb: 'Trusted across all three tiers', h: 'Government. Parastatal. Corporate.', lead: 'From Transnet and Unilever to the KZN Department of Education, leaders trust Khula to turn learning into lasting performance.', core: ['3', 'Client tiers served'], chips: ['Transnet', 'RCL Foods', 'Unilever'] },
];
const steps = [['Diagnose', 'Benchmark where your people, teams and leaders are today using psychometric tools and qualitative insight.'], ['Design', 'Build the intervention from scratch around your business, culture and desired outcomes.'], ['Deliver', 'Experiential, game-based facilitation and coaching, purpose-mapped to behavioural outcomes.'], ['Measure', 'Re-assess against the baseline so you can see exactly what has changed.']];
const values = ['Service excellence', 'Integrity', 'Collaboration', 'Flexibility', 'Transparency', 'Fairness'];
const ld = [org, { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.url, publisher: { '@id': SITE.url + '/#org' } }, faq(HOME_FAQ)];
---
<Base title="Corporate Training & NLP Coaching Durban | Khula" desc="Durban people-transformation consultancy. Tailored corporate training, NLP coaching, change & project management. 29+ years, trusted by Transnet, Unilever & government." path="/" active="home" ld={ld}>
  <section class="hero" aria-roledescription="carousel" aria-label="Khula highlights"><canvas id="fx" aria-hidden="true"></canvas>
    <div class="slides">
      {slides.map((s, i) => {
        const Tag = s.first ? 'h1' : 'div';
        return (
        <div class="slide" role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}`}><div class="wrap"><div>
          <span class="eyebrow">{s.eb}</span>
          <Tag class={s.caps ? 'h1 caps' : 'h1'}>{s.h.split('|').map((line, li, arr) => <Fragment>{line.split(' ').map((w, k) => <Fragment><span class="w"><span style={`--i:${k + li * 3}`}>{w}</span></span>{' '}</Fragment>)}{li < arr.length - 1 && <br />}</Fragment>)}</Tag>
          <p class="lead">{s.lead}</p>
          <div class="ctas"><a class="btn btn-p" href="/contact/#enquire">{s.cta ?? 'Book Appointment'} <Arrow /></a><a class="btn btn-g" href="/services/">Explore services</a></div>
          <div class="badge-row"><span><i></i>Durban-based</span><span><i></i>Gov · Parastatal · Corporate</span><span><i></i>Learning to Live, Living to Learn</span></div></div>
          <div class="vis" aria-hidden="true"><div class="ring"></div><div class="ring r2"></div><div class="core"><div><b>{s.core[0]}</b><small>{s.core[1]}</small></div></div>{s.chips.map((c) => <span class="chip">{c}</span>)}</div>
        </div></div>
      )})}
    </div>
    <div class="hero-ctrl"><div class="wrap">
      <div class="bars">{['Learning to live', 'People-transformation', 'Behaviour first', 'Trusted clients'].map((t) => <button aria-label={t}>{t}</button>)}</div>
      <div class="arrows"><button class="prev" aria-label="Previous slide"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 6l-6 6 6 6"/></svg></button><button class="next" aria-label="Next slide"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg></button></div>
      <button class="pause" type="button" aria-label="Pause slideshow" aria-pressed="false"><svg class="i-pause" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg><svg class="i-play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></button>
    </div></div>
    <div class="scroll-cue">Scroll</div>
  </section>

  <div class="marq" aria-label="Some of our clients"><div class="marq-label">Trusted by leading organisations</div><div class="track">{[...CLIENTS, ...CLIENTS].map((c) => <span>{c}</span>)}</div></div>

  <section class="sec"><div class="wrap split">
    <div class="rv l"><span class="eyebrow">Who we are</span><h2>Performance problem, or <span class="grad-text">behaviour problem?</span></h2>
      <p>A pattern we see time and again: organisations think they have a performance problem when what they actually have is a behaviour problem, the human operating system behind every strategy, system and target. What is usually missing isn't effort. It's behavioural alignment.</p>
      <p>Based in Durban, Khula Business Solutions has spent almost three decades helping leaders and organisations close that gap, moving from the performance they are delivering to the performance they are actually capable of.</p>
      <a class="btn btn-dark" href="/about/">Our story <Arrow /></a></div>
    <div class="rv r"><div class="quote"><blockquote>Sustainable performance is never just about strategy. It’s about the people executing it.</blockquote><cite>Thilo Nagiah, Founder</cite></div>
      <div class="stats"><div class="stat"><b data-to="29" data-suf="+">0</b><span>Years of people-transformation experience</span></div><div class="stat"><b data-to="100" data-suf="%">0</b><span>Female-owned & managed</span></div><div class="stat"><b data-to="9">0</b><span>Specialist services under one roof</span></div></div></div>
  </div></section>

  <section class="sec dark"><div class="wrap">
    <div class="sec-head rv"><span class="eyebrow">Our services</span><h2>We don’t deliver training. We solve business performance problems <span class="grad-text">through learning.</span></h2></div>
    <div class="cards">{SERVICES.map((s, i) => <a class="card rv" style={`--d:${i % 4}`} href={`/services/${s.slug}/`}><span class="n">{s.n}</span><Icon class="ic" d={s.icon} /><h3>{s.title}</h3><p>{s.short}</p><span class="go">Learn more <Arrow /></span></a>)}</div>
  </div></section>

  <section class="sec cream"><div class="wrap">
    <div class="sec-head rv center" style="text-align:center"><span class="eyebrow">What sets us apart</span><h2>Three things you won’t get from a <span class="grad-text">typical training provider</span></h2></div>
    <div class="feat">
      <div class="rv" style="--d:0"><span class="num">1</span><h3>Built from scratch, every time</h3><p>No recycled courseware. No programme that someone else already ran somewhere else. Every intervention is designed around your culture, your challenges and your numbers. One-size does not fit all.</p></div>
      <div class="rv" style="--d:1"><span class="num">2</span><h3>Experience-led, not just theory-led</h3><p>Learning is anchored through interactive, game-based methodologies, not just slide decks, so it sticks long after the session ends.</p></div>
      <div class="rv" style="--d:2"><span class="num">3</span><h3>Built for behaviour change</h3><p>Every activity is purpose-mapped to a behavioural outcome and debriefed using NLP-based techniques, giving a sharper understanding of how people think, communicate and get in their own way.</p></div>
    </div></div></section>

  <section class="sec dark"><div class="wrap">
    <div class="sec-head rv"><span class="eyebrow">How we work</span><h2>From diagnosis to <span class="grad-text">measured results</span></h2><p>A simple, evidence-led path so impact is measured, not assumed.</p></div>
    <div class="steps">{steps.map((s, i) => <div class="step rv" style={`--d:${i}`}><i>{i + 1}</i><h3>{s[0]}</h3><p>{s[1]}</p></div>)}</div>
  </div></section>

  <section class="sec"><div class="wrap">
    <div class="sec-head rv center" style="text-align:center"><span class="eyebrow">Client voices</span><h2>What our clients <span class="grad-text">say about us</span></h2></div>
    <div class="tcar rv"><div style="overflow:hidden"><div class="ttrack">{TESTIMONIALS.map((t) => <div class="tcard"><figure><blockquote>“{t[0]}”</blockquote><figcaption><span class="av">{t[1][0]}</span><div><b>{t[1]}</b><span>{t[2]}</span></div></figcaption></figure></div>)}</div></div><div class="tdots"></div></div>
  </div></section>

  <section class="sec tight dark"><div class="wrap center" style="text-align:center"><span class="eyebrow">Vision &amp; values</span>
    <h2 style="max-width:900px;margin:0 auto 28px">A vibrant learning community where excellence is celebrated, innovation thrives and <span class="grad-text">potential is realised.</span></h2>
    <div class="vals" style="justify-content:center">{values.map((v) => <span>{v}</span>)}</div></div></section>

  <section class="sec"><div class="wrap"><div class="sec-head rv center" style="text-align:center"><span class="eyebrow">FAQ</span><h2>Questions we hear often</h2></div><Faq items={HOME_FAQ} /></div></section>

  <CtaBand />
</Base>
