---
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import Icon from '../../components/Icon.astro';
import Tri from '../../components/Tri.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SERVICES } from '../../data/site.js';
import { crumbs } from '../../data/schema.js';
---
<Base title="Corporate Training, Coaching & Change Services | Khula Durban" desc="Specialist people-performance services: diagnostics, NLP coaching, tailored training, behaviour transformation, change & project management, train the trainer and more." path="/services/" active="services" ld={[crumbs([['Home', '/'], ['Services', '/services/']])]}>
  <section class="phero"><Tri /><div class="wrap"><div class="crumbs"><a href="/">Home</a><span>/</span>Services</div><span class="eyebrow">Our services</span><h1>We don’t deliver training. We solve business performance problems <span class="grad-text">through learning.</span></h1><p class="lead">Nine specialist services, each built from scratch around your culture, challenges and desired outcomes.</p></div></section>
  <section class="sec dark" style="padding-top:60px"><div class="wrap"><div class="cards">{SERVICES.map((s, i) => <a class="card rv" style={`--d:${i % 4}`} href={`/services/${s.slug}/`}><span class="n">{s.n}</span><Icon class="ic" d={s.icon} /><h2 style="font-size:1.25rem;color:#fff;margin:36px 0 10px">{s.title}</h2><p>{s.short}</p><span class="go">Learn more <Arrow /></span></a>)}</div></div></section>
  <CtaBand />
</Base>
