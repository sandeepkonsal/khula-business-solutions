# Khula Business Solutions – Apache
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On

# 1. Redirect old WordPress-site URLs to their new equivalents (keeps Google rankings and old links working)
RewriteRule ^about-us/?$ /about/ [R=301,L]
RewriteRule ^contact-us/?$ /contact/ [R=301,L]
RewriteRule ^service/?$ /services/ [R=301,L]
RewriteRule ^services/nlp-executive-business-life-coaching/?$ /services/nlp-executive-coaching/ [R=301,L]
RewriteRule ^our-team/?$ /about/ [R=301,L]
RewriteRule ^pricing/?$ /contact/ [R=301,L]
RewriteRule ^faq/?$ /#faq [NE,R=301,L]
RewriteRule ^(terms-conditions|privacy-policy-2)/?$ /privacy-policy/ [R=301,L]
RewriteRule ^(blog|portfolio|category|hello-world)(/.*)?$ / [R=301,L]
RewriteRule ^(why-financial-forecasting-is-key-to-your-business-success|how-to-optimize-your-business-budget-for-maximum-profitability|10-common-financial-mistakes-small-businesses-make-and-how-to-avoid-them|understanding-the-basics-of-investment-management|top-10-tips-for-effective-financial-planning|how-to-prepare-for-tax-season-a-comprehensive-guide|the-importance-of-estate-planning-protecting-your-legacy|managing-debt-strategies-for-financial-freedom|the-role-of-financial-advisors-how-they-can-help-you|insights-from-top-business-consultancy-experts)/?$ / [R=301,L]

# 2. Force https and the non-www domain
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://khulabusinesssolutions.co.za/$1 [R=301,L]

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
Header set X-Content-Type-Options "nosniff"
Header set X-Frame-Options "SAMEORIGIN"
Header set Referrer-Policy "strict-origin-when-cross-origin"
Header set Strict-Transport-Security "max-age=31536000"
</IfModule>
